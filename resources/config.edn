{:port 8088
 :auth-token "CHANGE_ME_IN_USER_HOME"
 :buttons
 [{:id "mute"
   :title "Mute Audio"
   :desc "Toggle Sink Mute"
   :icon "🔊"
   :cmd ["pactl" "set-sink-mute" "@DEFAULT_SINK@" "toggle"]}
  {:id "workspace-next"
   :title "Next Workspace"
   :desc "Desktop Switch"
   :icon "🖥️"
   :cmd ["xdotool" "key" "Super+Right"]}
  {:id "desk-lights"
   :title "Desk Lights"
   :desc "MQTT Toggle"
   :icon "💡"
   :cmd ["mosquitto_pub" "-h" "127.0.0.1" "-t" "home/desk/light" "-m" "TOGGLE"]}
  {:id "lock-screen"
   :title "Lock Screen"
   :desc "System Lock"
   :icon "🔒"
   :cmd ["xdotool" "key" "Super+l"]}]}
